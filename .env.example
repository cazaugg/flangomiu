# Copy to .env and fill in. Never commit the real .env.
# Generate a secret with: python -c 'import secrets; print(secrets.token_hex(32))'
SECRET_KEY=

ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Optional read-only account
GUEST_USERNAME=
GUEST_PASSWORD=

DATA_DIR=/data/flagomiu
TZ=Europe/Zurich
MAX_UPLOAD_MB=32

# Only needed when the frontend runs on another origin (comma separated).
CORS_ORIGINS=
